+bool StandaloneHost::hasAudioDevice(unsigned int id)
+{
+  guaranteeRtAudioDAC();
+  if (id == 0) return false;
+  auto dids = rtaDac->getDeviceIds();
+  return std::find(dids.begin(), dids.end(), id) != dids.end();
+}
+
+std::string StandaloneHost::audioDeviceName(unsigned int id)
+{
+  return hasAudioDevice(id) ? rtaDac->getDeviceInfo(id).name : std::string("None");
+}
